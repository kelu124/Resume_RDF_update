:proj_northern_energy_smartgrid a cvx:Project ;
    cvx:activitiesPerformed "Architected and implemented a streaming ingestion pipeline handling 6 TB/day of AMI meter readings using Apache Kafka and AWS Kinesis. Designed the asset knowledge graph in RDF/Turtle modelling 420,000 grid assets for SPARQL-based fault propagation analysis. Built automated data quality and anomaly detection jobs in PySpark. Developed the demand-side response data pipeline connecting 12,000 enrolled customers to the SCADA/DMS dispatch system. Contributed to Ofgem reporting datasets with programme lead Frodo Baggins." ;
    cvx:benefitsDelivered "Data platform processed peak load of 200,000 events/second without degradation. Supported a 14% improvement in SAIDI. Approximately 0.8% of erroneous meter readings caught before downstream processing." ;
    cvx:clientName "Northern Energy Holdings" ;
    cvx:domain "energy" ;
    cvx:endDate "2022-06-30"^^xsd:date ;
    cvx:projectDescription "Senior data engineering role building a real-time meter data platform and an asset knowledge graph underpinning a grid digital twin for an energy and utilities client." ;
    cvx:projectName "Northern Energy Holdings — Smart Grid Modernisation Programme" ;
    cvx:roleTitle "Data Engineering Lead" ;
