:proj_rivendell_fhir a cvx:Project ;
    cvx:activitiesPerformed "Conducted current-state assessment of 38 system integrations and 120 daily message flows. Produced target-state FHIR R4 resource model and migration sequencing plan. Built a proof-of-concept ingesting ADT feeds at 99.97% fidelity." ;
    cvx:benefitsDelivered "Proof-of-concept demonstrated 99.97% fidelity for ADT feed ingestion, validating the target architecture for full programme roll-out." ;
    cvx:clientName "Rivendell Health Systems" ;
    cvx:domain "healthcare" ;
    cvx:projectDescription "Redesigning a regional NHS trust's integration architecture from a custom HL7 v2 engine to a FHIR-native platform on Azure Health Data Services." ;
    cvx:projectName "Clinical Data Pipeline Modernisation" ;
    cvx:roleTitle "Lead Data Architect" ;
    cvx:startDate "2025-02-01"^^xsd:date ;
    cvx:usesSkill :skill_azure,
        :skill_fhir,
        :skill_hl7,
        :skill_python .

:proj_rohan_farming a cvx:Project ;
    cvx:activitiesPerformed "Built an MQTT-to-PostgreSQL ingestion pipeline for 1,200 in-field sensors. Developed a crop yield prediction model using scikit-learn (RMSE 8% below existing benchmarks). Built a farmer-facing reporting portal using Flask and Plotly, adopted by 160 members." ;
    cvx:benefitsDelivered "Participating farms reported 6% average yield improvement over two seasons. 160 cooperative members actively using the reporting portal." ;
    cvx:clientName "Rohan Agricultural Cooperative" ;
    cvx:domain "environment" ;
    cvx:endDate "2019-02-28"^^xsd:date ;
    cvx:projectDescription "Precision farming analytics platform for 340 cooperative members integrating IoT field sensors, satellite imagery, and agronomic models." ;
    cvx:projectName "Precision Farming Analytics Platform" ;
    cvx:roleTitle "Data Engineer (Junior)" ;
    cvx:startDate "2017-06-01"^^xsd:date ;
    cvx:usesSkill :skill_flask,
        :skill_postgresql,
        :skill_python,
        :skill_sklearn .

:proj_smart_grid_neh_2021 a cvx:Project ;
    cvx:activitiesPerformed "Built real-time AMI meter data ingestion handling 6 TB/day at peak throughput of 200,000 events/second using Apache Kafka on AWS MSK feeding a Redshift analytical layer. Developed an asset knowledge graph in RDF/Turtle modelling 420,000 grid components with full spatial and topological relationships and SPARQL-based fault impact queries. Implemented PySpark data quality and anomaly detection jobs processing meter readings against historical baselines. Built a demand-side response data pipeline connecting 12,000 enrolled residential customers to SCADA/DMS for real-time flexibility dispatch." ;
    cvx:benefitsDelivered "Platform sustained full load without degradation throughout delivery. 14% improvement in outage duration (SAIDI). 60% reduction in fault diagnosis time via asset graph queries. Anomaly detection flagged ~0.8% erroneous readings before reaching dispatch systems." ;
    cvx:clientName "Northern Energy Holdings" ;
    cvx:domain "energy" ;
    cvx:endDate "2022-06-30"^^xsd:date ;
    cvx:projectDescription "Data platform underpinning the digital twin and demand-side response programme for a regional UK distribution network operator under the Ofgem RIIO-ED2 price control." ;
    cvx:projectName "Smart Grid Modernisation" ;
    cvx:roleTitle "Data Platform Lead" ;
    cvx:startDate "2021-01-01"^^xsd:date ;
    cvx:usesSkill :skill_aws,
        :skill_kafka,
        :skill_kinesis,
        :skill_knowledge_graph,
        :skill_pyspark,
        :skill_python,
        :skill_rdf_turtle_sparql,
        :skill_redshift .

:proj_supply_chain_mordor_2022 a cvx:Project ;
    cvx:activitiesPerformed "Designed and executed data migration strategy for 800 GB of transactional history and 2.3 million master data records across 22 test runs over 16 months. Built an ETL framework in Python and AWS Glue with automated reconciliation reporting. Delivered a real-time operational data platform (Kafka + Redshift) replacing four point-to-point batch interfaces. Developed a REST API integration layer connecting S/4HANA to three 3PL partners (DHL, DB Schenker, local UK carrier). Produced and coordinated a 72-hour cutover runbook spanning 17 technical workstreams and 40 engineers across two time zones." ;
    cvx:benefitsDelivered "All seven sites went live on schedule. Zero data integrity issues raised in 90-day hypercare. Planning system data latency reduced from overnight batch to under 90 seconds." ;
    cvx:clientName "Mordor Industrial Group" ;
    cvx:domain "industry" ;
    cvx:endDate "2023-12-31"^^xsd:date ;
    cvx:projectDescription "Data migration and systems integration stream for a European industrial manufacturer replacing SAP ECC with S/4HANA across seven UK and German sites following supply chain disruption." ;
    cvx:projectName "Supply Chain Resilience — SAP S/4HANA Migration" ;
    cvx:roleTitle "Data Migration & Integration Lead" ;
    cvx:startDate "2022-08-01"^^xsd:date ;
    cvx:usesSkill :skill_aws,
        :skill_aws_glue,
        :skill_kafka,
        :skill_python,
        :skill_redshift,
        :skill_sap_s4hana,
        :skill_terraform .

:proj_wcc_esg_2024 a cvx:Project ;
    cvx:activitiesPerformed "Built a canonical ESG data model covering 500+ indicators aligned to SFDR, GRI 300-series, and TCFD pillars as a Turtle RDF knowledge graph. Developed ingestion pipelines for nine data providers (Clarity AI, Bloomberg ESG, in-house portfolio system) orchestrated in Apache Airflow on AWS MWAA. Implemented a PySpark-based SFDR PAI calculation engine replacing a quarterly Excel workbook. Designed an automated data quality framework with 140 rules covering completeness, temporal consistency, plausibility, and cross-source reconciliation. Delivered self-service Power BI dashboards with row-level security for 35 portfolio managers and the compliance team." ;
    cvx:benefitsDelivered "Reporting cycle reduced from 22 days to 4 days. First SFDR PAI report produced three weeks ahead of regulatory deadline. Audit trail coverage increased from 41% to 100%. PAI calculation engine runtime reduced from four weeks (manual) to under four hours." ;
    cvx:clientName "White Council Capital" ;
    cvx:domain "finance" ;
    cvx:endDate "2024-11-30"^^xsd:date ;
    cvx:projectDescription "Design and build of a canonical ESG data platform for White Council Capital, enabling continuous SFDR Article 8 PAI disclosure and full audit traceability, replacing a 22-day manual reporting cycle." ;
    cvx:projectName "ESG Reporting & Analytics Platform" ;
    cvx:roleTitle "Sustainability Data Engineer" ;
    cvx:startDate "2024-02-01"^^xsd:date ;
    cvx:usesSkill :skill_airflow,
        :skill_aws,
        :skill_gri,
        :skill_impact_measurement,
        :skill_knowledge_graph,
        :skill_powerbi,
        :skill_pyspark,
        :skill_python,
        :skill_rdf_turtle_sparql,
        :skill_redshift,
        :skill_sfdr,
        :skill_tcfd .

