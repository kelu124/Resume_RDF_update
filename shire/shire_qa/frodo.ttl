:proj_grey_havens_ops_2019 a cvx:Project ;
    cvx:activitiesPerformed "Assessed five in-flight initiatives, consolidated overlapping scope, and re-sequenced delivery against a revised £6 m budget. Recruited a permanent programme director and handed over with a fully baselined programme plan." ;
    cvx:benefitsDelivered "Programme formally restarted within six weeks; initial delivery milestones met the following quarter." ;
    cvx:clientName "Grey Havens Logistics" ;
    cvx:domain "transportation" ;
    cvx:endDate "2019-12-31"^^xsd:date ;
    cvx:projectDescription "Short-term engagement to recover a stalled digital operations review at a UK port logistics operator." ;
    cvx:projectName "Grey Havens Logistics — Digital Operations Review" ;
    cvx:roleTitle "Interim Programme Director" ;
    cvx:startDate "2019-09-01"^^xsd:date ;
    cvx:usesSkill :skill_programme_governance,
        :skill_programme_management,
        :skill_stakeholder_engagement .

:proj_mordor_supply_chain_2022 a cvx:Project ;
    cvx:activitiesPerformed "Developed and executed an enterprise-wide change management strategy covering 2,400 affected employees. Designed role-impact assessments and competency frameworks for 14 job families transitioning from legacy SAP to S/4HANA. Ran 18 executive workshops to align board-level sponsors on programme scope and risk appetite. Coordinated with the data and systems implementation team on process dependencies and cutover sequencing. Managed a €1.2 m change and communications budget, delivering 8% under budget." ;
    cvx:benefitsDelivered "Go-live achieved on schedule across all seven sites; user adoption score 84% at 90 days post-cutover (target: 75%)." ;
    cvx:clientName "Mordor Industrial Group" ;
    cvx:domain "industry" ;
    cvx:endDate "2023-12-31"^^xsd:date ;
    cvx:projectDescription "€40 m ERP and supply chain overhaul for a Tier-1 European industrial manufacturer following pandemic-era disruption, covering seven manufacturing sites in the UK and Germany." ;
    cvx:projectName "Mordor Industrial Group — Supply Chain Resilience Programme" ;
    cvx:roleTitle "Change Management Lead" ;
    cvx:startDate "2022-08-01"^^xsd:date ;
    cvx:usesSkill :skill_benefits_realisation,
        :skill_change_management,
        :skill_erp_transformation,
        :skill_programme_governance,
        :skill_stakeholder_engagement .

:proj_northern_energy_grid_2021 a cvx:Project ;
    cvx:activitiesPerformed "Defined and baselined a £28 m programme business case approved by the Ofgem price control framework. Architected a real-time grid telemetry platform ingesting 6 TB of meter data per day using an event-driven microservices pattern. Worked closely with the data engineering lead on data pipeline architecture and ontology design for the asset knowledge graph. Negotiated SLAs and integration contracts with three smart meter vendors. Presented programme progress quarterly to the Ofgem RIIO-ED2 liaison team." ;
    cvx:benefitsDelivered "98% AMI deployment across target zones; 14% reduction in outage duration (SAIDI); demand flexibility contracts secured with 12,000 residential customers." ;
    cvx:clientName "Northern Energy Holdings" ;
    cvx:domain "energy" ;
    cvx:endDate "2022-06-30"^^xsd:date ;
    cvx:projectDescription "£28 m smart grid modernisation programme at a regional distribution network operator serving 1.2 million customers, covering AMI rollout, SCADA/DMS integration, demand-side response, and data platform." ;
    cvx:projectName "Northern Energy Holdings — Smart Grid Modernisation Programme" ;
    cvx:roleTitle "Programme Lead / Technical Architect" ;
    cvx:startDate "2021-01-01"^^xsd:date ;
    cvx:usesSkill :skill_data_architecture,
        :skill_energy_systems,
        :skill_programme_governance,
        :skill_programme_management,
        :skill_rdf_knowledge_modelling,
        :skill_smart_grid .

:proj_shire_financial_mifid_2018 a cvx:Project ;
    cvx:activitiesPerformed "Led a team of four consultants and two internal business analysts through transaction reporting remediation. Mapped 340 reportable instruments to EMIR and MiFID II schemas; reduced reporting error rate from 9% to 0.3%. Introduced a regulatory change register that became the firm's standard governance tool." ;
    cvx:benefitsDelivered "Zero regulatory findings in subsequent FCA thematic review." ;
    cvx:clientName "Shire Financial Services" ;
    cvx:domain "finance" ;
    cvx:endDate "2019-08-31"^^xsd:date ;
    cvx:projectDescription "MiFID II and EMIR regulatory change programme for a mid-tier UK asset manager, coordinating across front office, technology, legal, and operations functions." ;
    cvx:projectName "Shire Financial Services — Regulatory Compliance Transformation" ;
    cvx:roleTitle "Lead Consultant – Regulatory Change" ;
    cvx:startDate "2018-03-01"^^xsd:date ;
    cvx:usesSkill :skill_programme_governance,
        :skill_regulatory_compliance,
        :skill_stakeholder_engagement .

:proj_wcc_esg_2024 a cvx:Project ;
    cvx:activitiesPerformed "Managed a cross-functional team of 12 (data engineering, compliance, front office) across London and Zurich. Defined the target data model and vendor selection process (shortlisted Clarity AI and MSCI; recommended Clarity AI). Drove stakeholder alignment between portfolio management, risk, and legal functions, resolving a six-month impasse over data ownership. Delivered first production SFDR PAI report three weeks ahead of regulatory deadline." ;
    cvx:benefitsDelivered "Reporting cycle reduced from 22 days to 4 days; audit trail coverage increased from 41% to 100%." ;
    cvx:clientName "White Council Capital" ;
    cvx:domain "finance" ;
    cvx:endDate "2024-11-30"^^xsd:date ;
    cvx:projectDescription "Group-wide ESG data platform for a mid-market asset manager managing €18 bn AUM, consolidating nine legacy data feeds into a single regulatory-grade reporting layer aligned to SFDR Article 8 and TCFD disclosure requirements." ;
    cvx:projectName "White Council Capital — ESG Reporting & Analytics Platform" ;
    cvx:roleTitle "Programme Manager" ;
    cvx:startDate "2024-02-01"^^xsd:date ;
    cvx:usesSkill :skill_data_architecture,
        :skill_esg_strategy,
        :skill_programme_governance,
        :skill_programme_management,
        :skill_stakeholder_engagement .

