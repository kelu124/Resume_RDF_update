# ─────────────────────────────────────────
# PROJECTS
# ─────────────────────────────────────────

:proj_esg_white_council a cvx:Project ;
    cvx:projectName "White Council Capital — ESG Reporting & Analytics Platform" ;
    cvx:projectDescription "Delivery of a regulatory-grade ESG reporting and analytics platform for a financial services group, covering SFDR, GRI, and TCFD reporting requirements with a knowledge-graph-backed provenance layer." ;
    cvx:clientName "White Council Capital" ;
    cvx:roleTitle "Sustainability Data Analyst & Engineer" ;
    cvx:startDate "2024-02-01"^^xsd:date ;
    cvx:endDate "2024-11-30"^^xsd:date ;
    cvx:activitiesPerformed "Designed the canonical ESG data model covering 500+ indicators aligned to SFDR, GRI, and TCFD schemas, including a Turtle RDF knowledge graph layer for provenance tracking. Built ingestion pipelines for nine data sources (Clarity AI, Bloomberg ESG, internal portfolio system) using Apache Airflow on AWS MWAA. Implemented automated data quality checks covering completeness, plausibility, and lineage. Built the SFDR PAI calculation engine in PySpark. Delivered self-service dashboards in Power BI." ;
    cvx:benefitsDelivered "Error rate fell from ~12% to under 0.5% at first downstream consumption. SFDR PAI compute cost reduced by 60% vs. incumbent Excel-based process. 35 portfolio managers using self-service dashboards from day one of go-live." ;
    cvx:domain "finance" ;
    cvx:usesSkill :skill_python ;
    cvx:usesSkill :skill_airflow ;
    cvx:usesSkill :skill_pyspark ;
    cvx:usesSkill :skill_aws ;
    cvx:usesSkill :skill_rdf_sparql ;
    cvx:usesSkill :skill_esg_data ;
    cvx:usesSkill :skill_power_bi ;
    cvx:usesSkill :skill_data_modelling .

:proj_mordor_supply_chain a cvx:Project ;
    cvx:projectName "Mordor Industrial Group — Supply Chain Resilience Programme" ;
    cvx:projectDescription "Lead data engineering role on a supply chain and ERP transformation programme covering seven manufacturing sites in the UK and Germany, migrating 14 years of transactional history from SAP ECC to S/4HANA and implementing a real-time operational data platform." ;
    cvx:clientName "Mordor Industrial Group" ;
    cvx:roleTitle "Data & Systems Implementation Consultant" ;
    cvx:startDate "2022-08-01"^^xsd:date ;
    cvx:endDate "2023-12-31"^^xsd:date ;
    cvx:activitiesPerformed "Designed the data migration strategy for ~800 GB of transactional history including cleansing rules for 2.3 million master data records. Built and maintained the ETL framework (Python + AWS Glue) for 22 migration runs. Implemented a real-time operational data platform (Kafka + Redshift) feeding MES and planning systems. Created the integration layer between S/4HANA and three third-party logistics providers via REST APIs. Owned the data cutover runbook, coordinating 17 technical workstreams across a 72-hour go-live window." ;
    cvx:benefitsDelivered "All seven manufacturing sites went live on schedule. Zero data integrity issues raised during the 90-day hypercare period." ;
    cvx:domain "industry" ;
    cvx:usesSkill :skill_python ;
    cvx:usesSkill :skill_aws ;
    cvx:usesSkill :skill_kafka ;
    cvx:usesSkill :skill_etl ;
    cvx:usesSkill :skill_sap_migration ;
    cvx:usesSkill :skill_sql .

:proj_northern_energy_smartgrid a cvx:Project ;
    cvx:projectName "Northern Energy Holdings — Smart Grid Modernisation Programme" ;
    cvx:projectDescription "Senior data engineering role building a real-time meter data platform and an asset knowledge graph underpinning a grid digital twin for an energy and utilities client." ;
    cvx:clientName "Northern Energy Holdings" ;
    cvx:roleTitle "Data Engineering Lead" ;
    cvx:startDate "2021-01-01"^^xsd:date ;
    cvx:endDate "2022-06-30"^^xsd:date ;
    cvx:activitiesPerformed "Architected and implemented a streaming ingestion pipeline handling 6 TB/day of AMI meter readings using Apache Kafka and AWS Kinesis. Designed the asset knowledge graph in RDF/Turtle modelling 420,000 grid assets for SPARQL-based fault propagation analysis. Built automated data quality and anomaly detection jobs in PySpark. Developed the demand-side response data pipeline connecting 12,000 enrolled customers to the SCADA/DMS dispatch system. Contributed to Ofgem reporting datasets with programme lead Frodo Baggins." ;
    cvx:benefitsDelivered "Data platform processed peak load of 200,000 events/second without degradation. Supported a 14% improvement in SAIDI. Approximately 0.8% of erroneous meter readings caught before downstream processing." ;
    cvx:domain "energy" ;
    cvx:usesSkill :skill_kafka ;
    cvx:usesSkill :skill_pyspark ;
    cvx:usesSkill :skill_rdf_sparql ;
    cvx:usesSkill :skill_knowledge_graphs ;
    cvx:usesSkill :skill_aws ;
    cvx:usesSkill :skill_data_modelling .

:proj_rivendell_fhir a cvx:Project ;
    cvx:projectName "Rivendell Health Systems — Clinical Data Pipeline Modernisation" ;
    cvx:projectDescription "Ongoing engagement to redesign the data integration architecture for a regional NHS trust, scoping a migration from a custom HL7 v2 integration engine to a FHIR-native platform using Azure Health Data Services." ;
    cvx:clientName "Rivendell Health Systems" ;
    cvx:roleTitle "Lead Data Architect" ;
    cvx:startDate "2025-02-01"^^xsd:date ;
    cvx:activitiesPerformed "Completed a current-state assessment covering 38 system integrations and 120 daily message flows. Designed target-state FHIR R4 resource model and migration sequencing plan. Delivered proof-of-concept ingesting patient ADT feeds into FHIR at 99.97% fidelity." ;
    cvx:benefitsDelivered "Proof-of-concept achieved 99.97% fidelity for patient ADT feed ingestion into FHIR. Clear migration sequencing plan produced for 38 integrations." ;
    cvx:domain "healthcare" ;
    cvx:usesSkill :skill_fhir ;
    cvx:usesSkill :skill_azure ;
    cvx:usesSkill :skill_data_modelling .

:proj_rohan_farming a cvx:Project ;
    cvx:projectName "Rohan Agricultural Cooperative — Precision Farming Analytics Platform" ;
    cvx:projectDescription "Built a precision farming analytics platform integrating IoT sensor data, satellite imagery, and agronomic models for a 340-member agricultural cooperative." ;
    cvx:clientName "Rohan Agricultural Cooperative" ;
    cvx:roleTitle "Junior / Mid Data Engineer" ;
    cvx:startDate "2017-06-01"^^xsd:date ;
    cvx:endDate "2019-02-28"^^xsd:date ;
    cvx:activitiesPerformed "Ingested data from 1,200 in-field sensors (soil moisture, temperature, yield monitors) via MQTT → PostgreSQL pipeline. Built a crop yield prediction model using scikit-learn gradient boosting. Created a farmer-facing reporting portal in Flask/Plotly." ;
    cvx:benefitsDelivered "Crop yield prediction RMSE 8% below cooperative's existing advisory benchmarks. Participating farms reported average yield improvement of 6% over two seasons. 160 members using the reporting portal by end of season 2." ;
    cvx:domain "other" ;
    cvx:usesSkill :skill_python ;
    cvx:usesSkill :skill_postgresql ;
    cvx:usesSkill :skill_iot ;
    cvx:usesSkill :skill_scikit_learn ;
    cvx:usesSkill :skill_flask .

:proj_gondor_infra a cvx:Project ;
    cvx:projectName "Gondor Municipal Authority — Infrastructure Monitoring & Reporting Platform" ;
    cvx:projectDescription "Designed and built an infrastructure monitoring and KPI reporting platform for a metropolitan local authority managing 4,200 assets including roads, bridges, drainage, and street lighting." ;
    cvx:clientName "Gondor Municipal Authority" ;
    cvx:roleTitle "Data Engineer" ;
    cvx:startDate "2019-03-01"^^xsd:date ;
    cvx:endDate "2020-02-28"^^xsd:date ;
    cvx:activitiesPerformed "Consolidated asset condition data from eight legacy systems (CSV exports, REST APIs, GIS shapefiles) into a unified PostgreSQL data warehouse. Built a dbt transformation layer producing 40 standardised KPI views. Developed geospatial analytics identifying 14 high-risk asset clusters." ;
    cvx:benefitsDelivered "Platform delivered in 11 weeks, 8 weeks ahead of original plan. Geospatial analysis directly informed a £3.2m capital investment decision. KPI views used by asset managers and the Cabinet Member for Transport." ;
    cvx:domain "public-sector" ;
    cvx:usesSkill :skill_python ;
    cvx:usesSkill :skill_dbt ;
    cvx:usesSkill :skill_postgresql ;
    cvx:usesSkill :skill_gis .

